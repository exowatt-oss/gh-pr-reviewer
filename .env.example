# GitHub App credentials and webhook verification (create your own GitHub App).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=gh-pr-reviewer
GITHUB_API_URL=https://api.github.com

# Explicit repository allowlist. Empty means no reviews; use owner/repository entries.
REVIEW_REPOS=
PILOT_REPOS=

# OpenAI-compatible chat-completions provider.
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4.1
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=900
# Optional provider-specific prompt layout; enable only when supported by your endpoint.
LLM_PROMPT_CACHE_LAYOUT=false

# Optional estimates; rates are USD per million tokens. Zero means unknown / not estimated.
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_CACHED_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0
LLM_MONTHLY_BUDGET_USD=0
REVIEW_TOOL_MAX_COST_USD=0

# Configure a real OIDC provider for any network-accessible deployment.
FORWARDED_AUTH_MODE=forwarded
FORWARDED_AUTH_ISSUER=
FORWARDED_AUTH_AUDIENCE=
FORWARDED_AUTH_ALLOWED_EMAIL_DOMAINS=
# Optional machine-reader token for /api/v1/stats/*; keep it secret.
STATS_API_TOKEN=

# Local-only development requires both explicit opt-ins; never expose this mode publicly.
# FORWARDED_AUTH_MODE=none
# FORWARDED_AUTH_ALLOW_INSECURE_NONE_MODE=true

DATA_DIR=./.data
DRY_RUN=false
